# Copia como .env para desarrollo local. Nunca subas el .env.

# 'memory' corre sin Firebase, con dos plantas de ejemplo en memoria.
STORAGE=memory
# Para usar Firestore: STORAGE=firestore y pega aquí el JSON completo de la cuenta de servicio en una línea.
FIREBASE_CREDENTIALS_JSON=

# Sin llave, los consejos se calculan por reglas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

DEVICE_API_KEY=clave-local-de-prueba
